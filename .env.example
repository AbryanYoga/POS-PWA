# Supabase / PostgreSQL Connection String (Pooler or Direct)
# Contoh: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:password@localhost:5432/pos_db"

# NextAuth / Auth.js Secret (bisa di-generate dengan `npx auth secret` atau `openssl rand -hex 32`)
AUTH_SECRET="supersecret_auth_token_for_pos_modern_32chars"
NEXTAUTH_URL="http://localhost:3000"

# Multi-toko default kode toko (opsional)
DEFAULT_KODE_TOKO="DEMO01"
